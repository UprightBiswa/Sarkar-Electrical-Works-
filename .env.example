# ─────────────────────────────────────────────────────────────
#  REQUIRED on Vercel (you type these 2)
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@sarkarelectrical.in
ADMIN_PASSWORD=choose-a-strong-password

# ─────────────────────────────────────────────────────────────
#  AUTO-FILLED by Vercel — don't type these
#  Storage → Neon  → DATABASE_URL
#  Storage → Blob  → BLOB_READ_WRITE_TOKEN
#  (Locally: leave empty → embedded database + /public/uploads)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────
#  OPTIONAL extras — add later only if you want them
# ─────────────────────────────────────────────────────────────
# GOOGLE_PLACES_API_KEY=   # import Google rating, reviews & shop photos
# RESEND_API_KEY=          # email alerts for bookings + reply to messages
# ADMIN_NOTIFY_EMAIL=      # where booking/message alerts go
# NEXT_PUBLIC_SITE_URL=    # only if you add a custom domain
